<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main>

        <fieldset>
            <legend>UTILISATEUR CONNECTÉ</legend>
            <label for="name">Nom d'utilisateur:</label> <span id="name"><%= user.userName %></span><br>
            <label for="email">E-mail :</label> <span id="email"><%= user.email %></span><br>
            <label for="date">Date :</label> <span id="date"><%= today.toLocaleDateString('fr-FR') %></span>
        </fieldset>
      
        <h2>RÉSERVATIONS EN COURS</h2>
        
        <table>
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Catway</th>
                    <th>Début</th>
                    <th>Fin</th>
                </tr>
            </thead>
                <tbody id="reservationTable">
                    <!-- dashboard.js remplira ce tableau -->
            </tbody>
        </table>
    </main>
      <script>
        // Injection des données envoyées par le controller
        const reservationsData =  JSON.parse('<%- JSON.stringify(reservations) %>') ;
        // const currentUser =  JSON.stringify(user);
    </script>
    <script src="/js/dashboard.js"></script>
</body>

</html>